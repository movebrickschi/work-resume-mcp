{
  "name": "work-resume-mcp",
  "version": "0.1.4",
  "description": "Cross-session resume MCP server for Cursor / Claude Code / Codex — keeps next_steps / summary / files_in_focus across disconnects, IDE crashes, and new sessions.",
  "keywords": ["mcp", "model-context-protocol", "cursor", "claude-code", "codex", "agent", "checkpoint", "resume", "work-resume", "ai", "tree-sitter"],
  "license": "MIT",
  "author": "movebrickschi",
  "homepage": "https://github.com/movebrickschi/work-resume-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movebrickschi/work-resume-mcp.git"
  },
  "bugs": { "url": "https://github.com/movebrickschi/work-resume-mcp/issues" },
  "type": "module",
  "bin": { "work-resume-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "rules", "examples", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "install-rules": "tsx src/index.ts install-rules --target all",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "execa": "^9.0.0",
    "web-tree-sitter": "^0.22.0",
    "tree-sitter-typescript": "^0.21.0",
    "tree-sitter-javascript": "^0.21.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-go": "^0.21.0",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-java": "^0.21.0",
    "tree-sitter-ruby": "^0.21.0",
    "tree-sitter-php": "^0.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
